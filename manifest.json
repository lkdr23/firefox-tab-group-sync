{
  "manifest_version": 3,
  "name": "Profile Tab Sync",
  "version": "2.0.0",
  "description": "Automatically sync this profile’s web tabs and native tab groups across desktop Firefox devices using your Mozilla account.",
  "author": "Sudhir Babu Nakka",
  "homepage_url": "https://github.com/sudhir-asuracore/firefox-tab-group-sync",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "profile-sync@firefox-tab-group-sync",
      "strict_min_version": "139.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sessions"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Profile Tab Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
